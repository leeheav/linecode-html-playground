# Administrator credentials. Use a unique username and a password of at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Required in production. Generate at least 32 random bytes and keep the value secret.
ADMIN_SESSION_SECRET=replace-with-an-independent-random-secret

# The container stores all persistent site data in its dedicated named volume.
SITES_DIR=/data/sites

# Days to retain files after a site expires or is taken offline (1-365).
SITE_RETENTION_DAYS=30

# Public origin for shared sites. A separate domain is recommended for stronger
# isolation; response CSP sandboxes published HTML when sharing an origin.
SITE_PUBLIC_BASE_URL=https://sites.example.net

# Browser-visible origin for the application UI. Never put a secret here.
NEXT_PUBLIC_BASE_URL=https://app.example.com
