# Administrator credentials. Use a unique username and a password of at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Required in production. Generate at least 32 random bytes and keep the value secret.
ADMIN_SESSION_SECRET=replace-with-an-independent-random-secret

# Optional. Defaults to <project>/data/sites. If Docker is used, this path must be on a mounted volume.
# SITES_DIR=/persistent/path/sites

# Public origin used in generated links.
NEXT_PUBLIC_BASE_URL=https://play.linecode.top
